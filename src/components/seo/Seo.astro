---
import { basePath, localePath, locales, ogLocale, siteName, type Locale } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  image?: string; // /public 기준 절대 경로 또는 import한 asset의 .src
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 이 페이지가 모든 로케일에 존재하면 true (hreflang 출력) */
  alternates?: boolean;
  publishedTime?: string;
}

const {
  title,
  description,
  lang,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  alternates = true,
  publishedTime,
} = Astro.props;
const SITE_NAME = siteName[lang];
const imageAlt = Astro.props.imageAlt ?? SITE_NAME;

if (!Astro.site) throw new Error('astro.config의 site가 비어 있습니다.');

// trailingSlash: 'never' 기준 정규화
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const base = basePath(path);
const altLinks = alternates
  ? locales.map((l) => ({ hreflang: l, href: new URL(localePath(base, l), Astro.site).href }))
  : [];
const xDefault = new URL(localePath(base, 'en'), Astro.site).href;

const ogImage = new URL(image, Astro.site).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;

const googleVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const naverVerify = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{altLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{alternates && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={ogLocale[lang]} />
{
  alternates &&
    locales
      .filter((l) => l !== lang)
      .map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)
}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{googleVerify && <meta name="google-site-verification" content={googleVerify} />}
{naverVerify && <meta name="naver-site-verification" content={naverVerify} />}

<link rel="sitemap" href="/sitemap-index.xml" />
